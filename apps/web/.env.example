# Copy to .env.local. Nothing here is a secret until you fill it in; never commit the filled-in file.

# The database owner on Neon (or local Postgres). Better Auth, `pnpm --filter @transpera-flow/db migrate` and the sign-in access
# functions use it. With DATABASE_URL and BETTER_AUTH_SECRET both unset the app runs in demo mode (/demo).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
# The `authenticator` login the app's queries use (create it with packages/db/scripts/create-app-login.sql). Falls back to DATABASE_URL.
# APP_DATABASE_URL=postgres://authenticator:...@host/db

# Better Auth
BETTER_AUTH_SECRET=change-me-to-32-or-more-random-characters
# This deployment's own URL; a preview deployment sets the stable alias here and signs in through it.
# BETTER_AUTH_URL=http://localhost:3000
# OAUTH_PROXY_SECRET=
# Comma-separated: google, microsoft (default google).
# AUTH_PROVIDERS=google
# Addresses that sign in as Admin whatever the access rules say, so a new deployment's first admin can get in.
# ACCESS_ADMIN_EMAILS=you@example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=

# Narration (Claude), server side only.
# ANTHROPIC_API_KEY=

# Error reporting (Sentry); nothing is sent without the DSN.
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
