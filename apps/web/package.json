{
  "name": "@transpera-flow/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --tags-filter='!perf'",
    "test:perf": "vitest run --tags-filter=perf --no-file-parallelism",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static --quiet",
    "visual": "playwright test -c playwright.visual.config.ts",
    "visual:update": "playwright test -c playwright.visual.config.ts --update-snapshots=all && node visual/prune.mjs",
    "visual:docker": "bash visual/docker.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@sentry/nextjs": "10.76.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@transpera-flow/db": "workspace:*",
    "@transpera-flow/engine": "workspace:*",
    "@transpera-flow/mcp": "workspace:*",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.49.0",
    "next": "16.3.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "unpdf": "^1.8.1"
