    "@storybook/react-vite": "10.6.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "pg": "^8.23.0",
    "playwright-core": "^1.63.0",
    "shadcn": "4.21.0",
    "storybook": "10.6.1",
