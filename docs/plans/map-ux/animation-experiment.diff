+/** An edge editor that stays readable at any zoom: only it follows the zoom, not every edge. */
+function Unscaled({ x, y, after, children }: { x: number; y: number; after: string; children: ReactNode }) {
+  const zoom = useStore((s) => s.transform[2]);
+  return (
+    <div className="nodrag nopan absolute" style={{ transform: `translate(${x}px, ${y}px) scale(${1 / zoom}) ${after}`, transformOrigin: "0 0", zIndex: 1002, pointerEvents: "all" }}>
+      {children}
+    </div>
+  );
+}
+
+/** The zoom buttons, which alone follow the zoom. */
+function LiveZoomControls({ onOut, onFit, onIn }: { onOut: () => void; onFit: () => void; onIn: () => void }) {
+  const zoom = useStore((st) => st.transform[2]);
+  return <ZoomControls zoom={zoom} onOut={onOut} onFit={onFit} onIn={onIn} canOut={zoom > MIN_ZOOM + 0.001} canIn={zoom < MAX_ZOOM - 0.001} />;
+}
+
+/** A function that keeps its identity across renders and always calls the latest `fn`. */
+function useStable<A extends unknown[], R>(fn: (...args: A) => R): (...args: A) => R {
+  const ref = useRef(fn);
+  useEffect(() => {
+    ref.current = fn;
+  });
+  return useCallback((...args: A) => ref.current(...args), []);
+}
