{
  "name": "@transpera-flow/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./issue-status": "./src/issue-status.ts",
    "./source-links": "./src/source-links.ts",
    "./process-file": "./src/process-file.ts",
    "./process-file-util": "./src/process-file-util.ts",
    "./process-file-2": "./src/process-file-2.ts",
    "./process-file-2-schema": "./src/process-file-2-schema.ts",
    "./simulation-gaps": "./src/simulation-gaps.ts",
    "./calibration": "./src/calibration.ts",
    "./csv-import": "./src/csv-import.ts",
    "./workspace-import": "./src/workspace-import.ts",
    "./money": "./src/money.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "gen:seed": "node --experimental-strip-types scripts/gen-seed.ts",
    "gen:import-schema": "node --experimental-strip-types scripts/gen-import-schema.ts",
    "gen:types": "node --experimental-strip-types scripts/gen-types.ts",
    "migrate": "node --experimental-strip-types scripts/migrate.ts",
    "copy:export": "node --experimental-strip-types scripts/copy-from-supabase/export.ts",
    "copy:import": "node --experimental-strip-types scripts/copy-from-supabase/import.ts",
    "copy:verify": "node --experimental-strip-types scripts/copy-from-supabase/verify.ts"
  },
  "dependencies": {
    "@transpera-flow/engine": "workspace:*",
    "kysely": "0.29.7",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@neondatabase/serverless": "1.2.0",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/ws": "8.18.1",
    "ajv": "^8.20.0",
    "eslint": "^9.39.5",
    "https-proxy-agent": "7.0.6",
    "kysely-codegen": "0.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2",
    "ws": "8.18.3"
  }
}
