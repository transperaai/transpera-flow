{
  "_about": "Cases for the play-link lever check, read by the database test (private.play_patch_problem, through submit_play_proposal) and by the app's TypeScript twin (apps/web/src/lib/share/play-input.ts, playPatchProblem). A path may hold $step, $stepOther (a step of another process in the snapshot), $role, $person, $service (ids in the snapshot and the workspace), $unseenStep (a real step of the workspace that is not in the snapshot), $foreignStep (a step of another workspace), $retiredStep (only under bundle.retired), $inventedStep (a uuid nowhere) and $deletedStep (in the snapshot, not in the workspace: database only). `levers` as a string \"$MANY:n\" means n copies of one valid change (only the length matters). `hidden` defaults to [\"process.rework\"]; `people` (the link shows people) to false. `expect` is the plain message, or null when the changes are acceptable. `dbOnly` cases need the workspace's tables.",
  "messages": {
    "invalid": "Those changes aren't valid.",
    "none": "Move at least one lever first.",
    "many": "Send at most 50 changes.",
    "duplicate": "Each lever can only be sent once.",
    "refused": "One of those changes can't be sent from a shared link.",
    "range": "One of the values is out of range.",
    "missing": "One of those changes points at something that isn't in this page."
  },
  "cases": [
    { "name": "leads set", "levers": [{ "path": "demand.leads_per_week", "op": "set", "value": 9 }], "expect": null },
    { "name": "active clients set, whole", "levers": [{ "path": "demand.active_clients", "op": "set", "value": 40 }], "expect": null },
    { "name": "monthly churn set", "levers": [{ "path": "demand.churn_monthly", "op": "set", "value": 0.03 }], "expect": null },
    { "name": "retainer set", "levers": [{ "path": "finances.retainer", "op": "set", "value": 2500 }], "expect": null },
    { "name": "service price set", "levers": [{ "path": "services.$service.price", "op": "set", "value": 1800 }], "expect": null },
    { "name": "role headcount set", "levers": [{ "path": "roles.$role.headcount", "op": "set", "value": 3 }], "expect": null },
    { "name": "step work hours multiply", "levers": [{ "path": "steps.$step.work_hours", "op": "multiply", "value": 0.8 }], "expect": null },
    { "name": "step wait hours multiply", "levers": [{ "path": "steps.$step.wait_hours", "op": "multiply", "value": 0.5 }], "expect": null },
    { "name": "step wait hours set", "levers": [{ "path": "steps.$step.wait_hours", "op": "set", "value": 4 }], "expect": null },
    { "name": "a step of another process in the snapshot", "levers": [{ "path": "steps.$stepOther.work_hours", "op": "multiply", "value": 1.2 }], "expect": null },
    { "name": "rework when its kind is not hidden", "hidden": [], "levers": [{ "path": "steps.$step.rework_rate", "op": "set", "value": 0.1 }], "expect": null },
    { "name": "rework multiply when its kind is not hidden", "hidden": [], "levers": [{ "path": "steps.$step.rework_rate", "op": "multiply", "value": 0.5 }], "expect": null },
    { "name": "a person's hours with People on", "people": true, "levers": [{ "path": "people.$person.fte", "op": "set", "value": 0.8 }], "expect": null },
    { "name": "several changes at once", "levers": [{ "path": "demand.leads_per_week", "op": "set", "value": 12 }, { "path": "steps.$step.work_hours", "op": "multiply", "value": 0.8 }], "expect": null },
    { "name": "the edge values are fine", "levers": [{ "path": "demand.churn_monthly", "op": "set", "value": 1 }, { "path": "demand.leads_per_week", "op": "set", "value": 0 }, { "path": "steps.$step.work_hours", "op": "multiply", "value": 2 }, { "path": "steps.$step.wait_hours", "op": "set", "value": 10000 }, { "path": "roles.$role.headcount", "op": "set", "value": 500 }, { "path": "people.$person.fte", "op": "set", "value": 1.5 }], "people": true, "expect": null },

    { "name": "a person's hours with People off", "levers": [{ "path": "people.$person.fte", "op": "set", "value": 0.8 }], "expect": "refused" },
    { "name": "a hidden kind (rework)", "levers": [{ "path": "steps.$step.rework_rate", "op": "set", "value": 0.1 }], "expect": "refused" },
    { "name": "a hidden kind (headcount)", "hidden": ["people.headcount"], "levers": [{ "path": "roles.$role.headcount", "op": "set", "value": 3 }], "expect": "refused" },
    { "name": "a hidden kind (prices, retainer)", "hidden": ["finances.prices"], "levers": [{ "path": "finances.retainer", "op": "set", "value": 3000 }], "expect": "refused" },
    { "name": "role cost rate", "levers": [{ "path": "roles.$role.cost_rate", "op": "set", "value": 50 }], "expect": "refused" },
    { "name": "role ongoing hours", "levers": [{ "path": "roles.$role.ongoing_hours", "op": "set", "value": 5 }], "expect": "refused" },
    { "name": "service mix share", "levers": [{ "path": "services.$service.mix_share", "op": "set", "value": 0.5 }], "expect": "refused" },
    { "name": "service churn health sensitivity", "levers": [{ "path": "services.$service.churn_health_sensitivity", "op": "set", "value": 0.5 }], "expect": "refused" },
    { "name": "health setting", "levers": [{ "path": "health.initial", "op": "set", "value": 0.5 }], "expect": "refused" },
    { "name": "a selector (busiest role)", "levers": [{ "path": "roles.@busiest.headcount", "op": "set", "value": 3 }], "expect": "refused" },
    { "name": "a selector (heaviest step)", "levers": [{ "path": "steps.@heaviest.work_hours", "op": "multiply", "value": 0.5 }], "expect": "refused" },

    { "name": "leads too many", "levers": [{ "path": "demand.leads_per_week", "op": "set", "value": 10001 }], "expect": "range" },
    { "name": "leads negative", "levers": [{ "path": "demand.leads_per_week", "op": "set", "value": -1 }], "expect": "range" },
    { "name": "leads with add", "levers": [{ "path": "demand.leads_per_week", "op": "add", "value": 2 }], "expect": "range" },
    { "name": "leads with multiply", "levers": [{ "path": "demand.leads_per_week", "op": "multiply", "value": 2 }], "expect": "range" },
    { "name": "active clients not whole", "levers": [{ "path": "demand.active_clients", "op": "set", "value": 12.5 }], "expect": "range" },
    { "name": "active clients too many", "levers": [{ "path": "demand.active_clients", "op": "set", "value": 100001 }], "expect": "range" },
    { "name": "churn above 1", "levers": [{ "path": "demand.churn_monthly", "op": "set", "value": 1.01 }], "expect": "range" },
    { "name": "retainer too high", "levers": [{ "path": "finances.retainer", "op": "set", "value": 10000001 }], "expect": "range" },
    { "name": "service price negative", "levers": [{ "path": "services.$service.price", "op": "set", "value": -5 }], "expect": "range" },
    { "name": "headcount not whole", "levers": [{ "path": "roles.$role.headcount", "op": "set", "value": 2.5 }], "expect": "range" },
    { "name": "headcount too high", "levers": [{ "path": "roles.$role.headcount", "op": "set", "value": 501 }], "expect": "range" },
    { "name": "fte too high", "people": true, "levers": [{ "path": "people.$person.fte", "op": "set", "value": 1.6 }], "expect": "range" },
    { "name": "work hours multiply too low", "levers": [{ "path": "steps.$step.work_hours", "op": "multiply", "value": 0.05 }], "expect": "range" },
    { "name": "work hours multiply too high", "levers": [{ "path": "steps.$step.work_hours", "op": "multiply", "value": 3 }], "expect": "range" },
    { "name": "work hours set", "levers": [{ "path": "steps.$step.work_hours", "op": "set", "value": 2 }], "expect": "range" },
    { "name": "wait set too high", "levers": [{ "path": "steps.$step.wait_hours", "op": "set", "value": 10001 }], "expect": "range" },
    { "name": "rework set too high", "hidden": [], "levers": [{ "path": "steps.$step.rework_rate", "op": "set", "value": 0.6 }], "expect": "range" },
    { "name": "step with add", "levers": [{ "path": "steps.$step.wait_hours", "op": "add", "value": 1 }], "expect": "range" },

    { "name": "a step of another workspace", "levers": [{ "path": "steps.$foreignStep.work_hours", "op": "multiply", "value": 0.8 }], "expect": "missing" },
    { "name": "a real step of this workspace that is not in the snapshot", "levers": [{ "path": "steps.$unseenStep.work_hours", "op": "multiply", "value": 0.8 }], "expect": "missing" },
    { "name": "a retired step", "levers": [{ "path": "steps.$retiredStep.work_hours", "op": "multiply", "value": 0.8 }], "expect": "missing" },
    { "name": "an invented step id", "levers": [{ "path": "steps.$inventedStep.work_hours", "op": "multiply", "value": 0.8 }], "expect": "missing" },
    { "name": "an id that is not a uuid", "levers": [{ "path": "steps.not-a-uuid.work_hours", "op": "multiply", "value": 0.8 }], "expect": "missing" },
    { "name": "a role of another workspace", "levers": [{ "path": "roles.$foreignStep.headcount", "op": "set", "value": 3 }], "expect": "missing" },
    { "name": "a service of another workspace", "levers": [{ "path": "services.$foreignStep.price", "op": "set", "value": 3 }], "expect": "missing" },
    { "name": "a person of another workspace", "people": true, "levers": [{ "path": "people.$foreignStep.fte", "op": "set", "value": 1 }], "expect": "missing" },
    { "name": "in the snapshot but deleted from the workspace", "dbOnly": true, "levers": [{ "path": "steps.$deletedStep.work_hours", "op": "multiply", "value": 0.8 }], "expect": "missing" },

    { "name": "no changes", "levers": [], "expect": "none" },
    { "name": "51 changes", "levers": "$MANY:51", "expect": "many" },
    { "name": "the same path twice", "levers": [{ "path": "demand.leads_per_week", "op": "set", "value": 9 }, { "path": "demand.leads_per_week", "op": "set", "value": 10 }], "expect": "duplicate" },
    { "name": "not an array", "levers": { "path": "demand.leads_per_week", "op": "set", "value": 9 }, "expect": "invalid" },
    { "name": "a value that is not a number", "levers": [{ "path": "demand.leads_per_week", "op": "set", "value": "9" }], "expect": "invalid" },
    { "name": "an extra key", "levers": [{ "path": "demand.leads_per_week", "op": "set", "value": 9, "note": "x" }], "expect": "invalid" },
    { "name": "an unknown path", "levers": [{ "path": "demand.leads", "op": "set", "value": 9 }], "expect": "invalid" },
    { "name": "an unknown op", "levers": [{ "path": "demand.leads_per_week", "op": "divide", "value": 9 }], "expect": "invalid" }
  ]
}
