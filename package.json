{
  "name": "transpera-flow",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @transpera-flow/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
